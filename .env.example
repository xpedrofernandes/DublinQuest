# Copy to .env and replace every change-me value before startup.
POSTGRES_DB=dublinquest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin-password
DATABASE_USER=dublinquest
DATABASE_PASSWORD=change-me-app-password
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
DOCKER_SUBNET=172.28.40.0/24
# Required for pedestrian routes and walking estimates; the core app runs without it.
# Obtain your own key at https://account.heigit.org/ and set it in the local .env only.
ORS_API_KEY=
